package main

import (
	"fmt"
)

type ListNode struct {
	Val  int
	Next *ListNode
}

func reverseList(head *ListNode) *ListNode {
	p := head

	var prev *ListNode
	for p != nil {
		if p.Next == nil {
			head = p
		}
		next := p.Next
		p.Next = prev
		prev = p
		p = next
	}

	return head
}

func main() {
	head := istNode{
		Val: 1,
		Next: &ListNode{
			Val: 2,
			Next: &ListNode{
				Val: 3,
				Next: &ListNode{
					Val: 4,
					Next: &ListNode{
						Val: 5,
					},
				},
			},
		},
	}
	out := reverseList(&head)

	for out != nil {
		fmt.Printf("%d, ", out.Val)
		out = out.Next
	}
}
